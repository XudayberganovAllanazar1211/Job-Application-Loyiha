# Required for production
FINJOB_ENV=development
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_TTL_HOURS=12
FORCE_HTTPS=0

# FinJob payment configuration
# Get these values from the Click merchant/billing account.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=http://localhost:5173/jobs

# Payme wallet top-ups (see docs/PAYME_INTEGRATION.md). Disabled unless EVERY required value is set.
# Explicit master switch. Having credentials in the environment is NOT enough.
PAYME_ENABLED=0
# Must be set explicitly: 1 = Payme test merchant, 0 = live merchant.
# Test mode is refused when FINJOB_ENV=production. Live mode refuses the public test merchant (4056281).
PAYME_TEST_MODE=1
PAYME_MERCHANT_ID=
# Payment secret key from the Payme merchant cabinet (never commit, never expose to the frontend).
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_BASE_URL=https://pay.payme.uz
# Public HTTPS URL of this backend's callback (Payme POSTs signed order results here).
PAYME_CALLBACK_URL=https://YOUR-API-HOST/payments/payme/callback
# Public URL of this backend's browser-return endpoint (redirect only, never credits).
PAYME_RESPONSE_URL=https://YOUR-API-HOST/wallet/deposits/return
# Frontend page the user lands on afterwards (the wallet/profile page).
PAYME_FRONTEND_RETURN_URL=http://localhost:5173/profile
PAYME_ORDER_LIFETIME_SECONDS=3600
PAYME_MIN_AMOUNT_UZS=1000
PAYME_MAX_AMOUNT_UZS=50000000
PAYME_MAX_OPEN_DEPOSITS=5
# Optional: comma-separated callback source IPs. Payme documents 54.154.216.60 and 3.75.125.89.
# Only meaningful if request.remote_addr is the real client IP (configure your proxy accordingly).
PAYME_CALLBACK_IP_ALLOWLIST=

# Wallet test settings
# Platform commission (0-100) used ONLY to seed a brand-new database (fresh-install default is 2).
# Existing databases keep their stored value: see docs/PAYME_INTEGRATION.md.
FINJOB_COMMISSION_PERCENT=2

MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
GOOGLE_CLIENT_ID=your-google-oauth-client-id
