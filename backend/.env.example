# Database configuration (use a dedicated database for tests)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/finjob_test?sslmode=require
NEON_BRANCH=finjob-development
DATABASE_SCHEMA=finjob_data
# Set to 1 ONLY for a brand-new empty database with no SQLite data to import.
FINJOB_ALLOW_EMPTY_DB_BOOTSTRAP=0

# Required for production
FINJOB_ENV=development
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_TTL_HOURS=12
FORCE_HTTPS=0

# FinJob payment configuration
# Get these values from the Click merchant/billing account.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=http://localhost:5173/jobs

# Dummy/test wallet
# Percentage kept by FinJob from test payments (0-100).
FINJOB_COMMISSION_PERCENT=10

MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
GOOGLE_CLIENT_ID=your-google-oauth-client-id
